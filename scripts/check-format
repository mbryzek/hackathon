#!/usr/bin/env bash
# dev-script: targets=local
#
# THE FORMAT CHECK, ADVISORY (ISS-19427). Prints every file this repository's own
# formatters (scalafmt, ocamlformat through dune, prettier) would rewrite, one
# line each in the advisory finding shape, and exits 0 whatever it finds:
# formatting never fails a build. `ci/build.sh` declares it with a
# `# ci-advisory: scripts/check-format` line, so the build runs it and files each
# new finding that is not baselined as its own issue, blocked on the build.
# `dev ci hygiene` counts what `main` carries and files nothing.
#
# Exit 1 only when a formatter this repository configures could not answer, so
# a partial list is never read as the whole answer. This file is a copy of
# devops templates/ci/check-format; the logic is `dev fmt report`.
set -euo pipefail
cd "$(dirname "$0")/.."
exec dev fmt report "$@"
